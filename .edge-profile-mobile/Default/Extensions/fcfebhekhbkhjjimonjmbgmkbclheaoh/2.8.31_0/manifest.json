   "permissions": [ "notifications", "alarms", "contextMenus", "webRequest", "webNavigation", "downloads", "storage", "cookies", "tabs", "offscreen", "unlimitedStorage", "declarativeNetRequest", "declarativeNetRequestFeedback", "declarativeNetRequestWithHostAccess", "scripting" ],
   "short_name": "__MSG_global_extension_shortName__",
